# VPS production env template — copy to prod.env on the server (never commit prod.env).
# Replace YOUR_DOMAIN and fill all secrets before `docker compose ... up`.
#
#   cp docs/ops/prod.env.vps.example prod.env
#   # edit prod.env
#
# Generate secrets, e.g.:  openssl rand -base64 48

# --- Public hostname (DNS A/AAAA must point here before Let's Encrypt works) ---
DOMAIN=YOUR_DOMAIN

# --- Database ---
DB_NAME=projectanalytics
DB_USERNAME=projectanalytics
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# --- Redis (optional empty if Redis has no auth) ---
REDIS_PASSWORD=

# --- ProductionSecurityValidator (required) ---
# >= 32 chars, NOT the local/dev JWT default
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# >= 32 chars, MUST differ from JWT_SECRET
CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_OTHER_LONG_RANDOM_SECRET
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN

# --- App / OpenAPI (prod overlay also forces these) ---
LOG_LEVEL=INFO
APP_VERSION=1.0.0
OPENAPI_PUBLIC=false
OP_ALLOW_ENV_API_KEY_FALLBACK=false
REGISTRATION_ENABLED=true

# --- Reports inside the backend container ---
REPORT_STORAGE_PATH=/data/reports
REPORT_RETENTION_DAYS=90
REPORT_PURGE_ENABLED=true
ANALYTICS_SNAPSHOT_RETENTION_DAYS=90
ANALYTICS_SNAPSHOT_PURGE_ENABLED=true

# --- Sync / OpenProject (credentials preferably per-workspace in UI; env key disabled in prod) ---
OPENPROJECT_URL=
OPENPROJECT_API_KEY=
OPENPROJECT_VERIFY_SSL=true
SYNC_ENABLED=true
SYNC_INTERVAL_MS=3600000

# --- OAuth redirects (must match YOUR_DOMAIN when using OAuth) ---
OPENPROJECT_OAUTH_REDIRECT_URI=https://YOUR_DOMAIN/api/v1/workspaces/oauth/callback
OPENPROJECT_OAUTH_FRONTEND_SUCCESS_URL=https://YOUR_DOMAIN/workspaces?oauth=success
OPENPROJECT_OAUTH_FRONTEND_ERROR_URL=https://YOUR_DOMAIN/workspaces?oauth=error
OPENPROJECT_OAUTH_CLIENT_ID=
OPENPROJECT_OAUTH_CLIENT_SECRET=
OPENPROJECT_OAUTH_SCOPES=api_v3

# --- SMTP (Gmail App Password — quote if spaces) ---
PASSWORD_RESET_MAIL_ENABLED=true
PASSWORD_RESET_MAIL_FROM=projectanalytics.contact@gmail.com
PASSWORD_RESET_FRONTEND_BASE_URL=https://YOUR_DOMAIN
EMAIL_CONFIRMATION_TTL_MINUTES=1440
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=projectanalytics.contact@gmail.com
MAIL_PASSWORD='REPLACE_WITH_GMAIL_APP_PASSWORD'
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true

# Frontend build-arg (relative API; nginx proxies /api/ → backend:8080)
API_BASE_URL=/api/v1
