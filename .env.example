# Project Analytics — example environment variables
# Copy to `.env` for local use. Never commit real secrets.
#
# Local/dev values are below. For production Docker (N5.1 overlay), see the
# PRODUCTION section at the bottom and docs/ops/n5.1-prod-compose.md.

# =============================================================================
# LOCAL / DEVELOPMENT
# =============================================================================

# --- Server ---
SERVER_PORT=8080
SERVER_CONTEXT_PATH=
SPRING_PROFILES_ACTIVE=dev
APP_VERSION=1.0.0-SNAPSHOT
LOG_LEVEL=DEBUG

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projectanalytics
DB_USERNAME=projectanalytics
DB_PASSWORD=projectanalytics

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# --- CORS / Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8088
FRONTEND_PORT=8088
API_BASE_URL=http://localhost:8080/api/v1

# --- JWT — local default only; NEVER use this value in prod ---
JWT_SECRET=project-analytics-dev-jwt-secret-change-me-32b
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=86400

# --- Credential encryption (M14) ---
# Local/dev: optional (falls back to JWT_SECRET). Prod: REQUIRED and ≠ JWT_SECRET.
CREDENTIALS_ENCRYPTION_KEY=

# Registration (M14a). Set false for invite-only / locked deploys.
REGISTRATION_ENABLED=true

# Password reset / email confirmation (mail off by default in local).
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_FRONTEND_BASE_URL=http://localhost:4200
PASSWORD_RESET_MAIL_FROM=noreply@projectanalytics.local
PASSWORD_RESET_MAIL_ENABLED=false
EMAIL_CONFIRMATION_TTL_MINUTES=1440
# SMTP (Gmail example — use an App Password, never commit it). See docs/ops/smtp-setup.md
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=projectanalytics.contact@gmail.com
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_SMTP_STARTTLS_REQUIRED=true
# Then set:
# PASSWORD_RESET_MAIL_ENABLED=true
# PASSWORD_RESET_MAIL_FROM=projectanalytics.contact@gmail.com

# Auth rate limits. Still put an edge/WAF limit in front of production.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_REGISTER_MAX=5
AUTH_RATE_LIMIT_FORGOT_MAX=5
AUTH_RATE_LIMIT_RESET_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Env OPENPROJECT_API_KEY fallback — local/dev only. Forced false in prod profile.
OP_ALLOW_ENV_API_KEY_FALLBACK=true

# --- OpenProject ---
OPENPROJECT_URL=https://openproject.example.com
OPENPROJECT_API_KEY=
OPENPROJECT_TIMEOUT=30
OPENPROJECT_VERIFY_SSL=true
OP_ELIGIBLE_ROLE_TITLES=Project admin

# OAuth (optional global defaults; multi-OP uses per-workspace client id/secret in UI)
OPENPROJECT_OAUTH_CLIENT_ID=
OPENPROJECT_OAUTH_CLIENT_SECRET=
OPENPROJECT_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/workspaces/oauth/callback
OPENPROJECT_OAUTH_SCOPES=api_v3
OPENPROJECT_OAUTH_FRONTEND_SUCCESS_URL=http://localhost:4200/workspaces?oauth=success
OPENPROJECT_OAUTH_FRONTEND_ERROR_URL=http://localhost:4200/workspaces?oauth=error
OPENPROJECT_OAUTH_STATE_TTL_SECONDS=600

# --- Synchronization ---
SYNC_ENABLED=true
SYNC_INTERVAL_MS=3600000
SYNC_BATCH_SIZE=100
SYNC_RETRY_COUNT=1
SYNC_TIMEOUT=120
SYNC_SUCCESS_STALE_SECONDS=86400

# Reporting / snapshots
# Local (scripts from repo root + ./scripts/run-backend.sh → backend/): use backend/data/reports.
# Docker compose uses /data/reports inside the container.
REPORT_STORAGE_PATH=./backend/data/reports
REPORT_RETENTION_DAYS=90
REPORT_PURGE_ENABLED=true
MAX_REPORT_SIZE=10485760
ANALYTICS_SNAPSHOT_RETENTION_DAYS=90
ANALYTICS_SNAPSHOT_PURGE_ENABLED=true
OPENAPI_PUBLIC=true
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=14

# Observability compose (optional)
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# PRODUCTION (N5.1 compose overlay + ProductionSecurityValidator)
# =============================================================================
# Use a separate env file for prod (e.g. prod.env) — never commit real secrets.
# Generate secrets, for example:
#   openssl rand -base64 48
#
# Run:
#   docker compose -p project-analytics-prod \
#     -f docker/docker-compose.yml \
#     -f docker/docker-compose.prod.yml \
#     --env-file prod.env \
#     up -d --build
#
# See: docs/ops/n5.1-prod-compose.md

# --- Required by ProductionSecurityValidator (@Profile("prod")) ---
# JWT_SECRET must be >= 32 chars and MUST NOT equal the local default above.
# JWT_SECRET=
# CREDENTIALS_ENCRYPTION_KEY must be >= 32 chars and MUST differ from JWT_SECRET.
# CREDENTIALS_ENCRYPTION_KEY=
# CORS_ALLOWED_ORIGINS must be explicit (HTTPS in real deploy). No "*".
# CORS_ALLOWED_ORIGINS=https://analytics.example.com

# --- Required by docker-compose.prod.yml ---
# SPRING_PROFILES_ACTIVE is forced to "prod" by the overlay; setting it here is fine.
# SPRING_PROFILES_ACTIVE=prod
# DB_NAME=projectanalytics
# DB_USERNAME=projectanalytics
# DB_PASSWORD=          # strong password — required
# REDIS_PASSWORD=      # optional if Redis has no auth

# --- Forced by prod overlay / application-prod.yml (document intent) ---
# OPENAPI_PUBLIC=false
# OP_ALLOW_ENV_API_KEY_FALLBACK=false

# --- Isolated host ports (N5.1 defaults; override if needed) ---
# PROD_DB_PORT=5433
# PROD_REDIS_PORT=6380
# PROD_SERVER_PORT=8081
# PROD_FRONTEND_PORT=8089

# --- Production frontend / OAuth URLs (set to your public origins) ---
# API_BASE_URL=/api/v1
# PASSWORD_RESET_FRONTEND_BASE_URL=https://analytics.example.com
# OPENPROJECT_OAUTH_REDIRECT_URI=https://analytics.example.com/api/v1/workspaces/oauth/callback
# OPENPROJECT_OAUTH_FRONTEND_SUCCESS_URL=https://analytics.example.com/workspaces?oauth=success
# OPENPROJECT_OAUTH_FRONTEND_ERROR_URL=https://analytics.example.com/workspaces?oauth=error

# --- Reports inside the prod container (overlay default) ---
# REPORT_STORAGE_PATH=/data/reports

# --- SMTP (Gmail / any provider — required for real signup confirmation & password reset) ---
# PASSWORD_RESET_MAIL_ENABLED=true
# PASSWORD_RESET_MAIL_FROM=projectanalytics.contact@gmail.com
# PASSWORD_RESET_FRONTEND_BASE_URL=https://analytics.example.com
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=projectanalytics.contact@gmail.com
# MAIL_PASSWORD=                # Google App Password — never commit
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_SMTP_STARTTLS_REQUIRED=true

# --- Recommended lock-down ---
# REGISTRATION_ENABLED=false
# LOG_LEVEL=INFO
