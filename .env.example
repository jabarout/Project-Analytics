# Project Analytics — example environment variables (Milestone 1+)
# Copy to .env for local use. Never commit real secrets.

# --- Server ---
SERVER_PORT=8080
SERVER_CONTEXT_PATH=
SPRING_PROFILES_ACTIVE=dev
APP_VERSION=1.0.0-SNAPSHOT
LOG_LEVEL=DEBUG

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projectanalytics
DB_USERNAME=projectanalytics
DB_PASSWORD=projectanalytics

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# --- CORS / Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8088
FRONTEND_PORT=8088
API_BASE_URL=http://localhost:8080/api/v1

# --- JWT (Milestone 2) — required for production; use a long random secret ---
JWT_SECRET=project-analytics-dev-jwt-secret-change-me-32b
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=86400

# --- OpenProject (Milestone 3) ---
OPENPROJECT_URL=https://openproject.example.com
OPENPROJECT_API_KEY=
OPENPROJECT_TIMEOUT=30
OPENPROJECT_VERIFY_SSL=true

# --- Synchronization ---
SYNC_ENABLED=true
SYNC_INTERVAL_MS=3600000
SYNC_BATCH_SIZE=100
SYNC_RETRY_COUNT=1
SYNC_TIMEOUT=120
# Ops: max age (seconds) of last SUCCESS sync for stale-sync metric/alert (default 24h)
SYNC_SUCCESS_STALE_SECONDS=86400

# Reporting storage (immutable historical files; backed up with Postgres)
REPORT_STORAGE_PATH=./data/reports
REPORT_RETENTION_DAYS=90
REPORT_PURGE_ENABLED=true
MAX_REPORT_SIZE=10485760
ANALYTICS_SNAPSHOT_RETENTION_DAYS=90
ANALYTICS_SNAPSHOT_PURGE_ENABLED=true
OPENAPI_PUBLIC=true
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=14

# Observability compose (optional overlay)
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
