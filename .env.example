# Project Analytics — example environment variables (Milestone 1+)
# Copy to .env for local use. Never commit real secrets.

# --- Server ---
SERVER_PORT=8080
SERVER_CONTEXT_PATH=
SPRING_PROFILES_ACTIVE=dev
APP_VERSION=1.0.0-SNAPSHOT
LOG_LEVEL=DEBUG

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projectanalytics
DB_USERNAME=projectanalytics
DB_PASSWORD=projectanalytics

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# --- CORS / Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8088
FRONTEND_PORT=8088
API_BASE_URL=http://localhost:8080/api/v1

# --- JWT (Milestone 2) — required for production; use a long random secret ---
JWT_SECRET=project-analytics-dev-jwt-secret-change-me-32b
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=86400

# --- Credential encryption (Phase 3 / M14) ---
# Encrypts per-workspace OpenProject API keys / OAuth tokens at rest.
# Local/dev: optional (falls back to JWT_SECRET). Prod: REQUIRED and must differ from JWT_SECRET.
CREDENTIALS_ENCRYPTION_KEY=

# Registration (M14a). Set false for invite-only / locked deploys.
REGISTRATION_ENABLED=true

# Password reset (Phase 4). Mail off by default; local/dev logs a reset link instead.
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_FRONTEND_BASE_URL=http://localhost:4200
PASSWORD_RESET_MAIL_FROM=noreply@projectanalytics.local
PASSWORD_RESET_MAIL_ENABLED=false
# Also used for signup confirmation emails when true.
EMAIL_CONFIRMATION_TTL_MINUTES=1440
# spring.mail.host=smtp.example.com
# spring.mail.port=587
# spring.mail.username=
# spring.mail.password=

# Auth rate limits (Phase 5). Still put an edge/WAF limit in front of production.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_REGISTER_MAX=5
AUTH_RATE_LIMIT_FORGOT_MAX=5
AUTH_RATE_LIMIT_RESET_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Env OPENPROJECT_API_KEY as connect/sync fallback — local/dev only. Forced false in prod profile.
OP_ALLOW_ENV_API_KEY_FALLBACK=true

# --- OpenProject (Milestone 3 / M14) ---
OPENPROJECT_URL=https://openproject.example.com
OPENPROJECT_API_KEY=
OPENPROJECT_TIMEOUT=30
OPENPROJECT_VERIFY_SSL=true
# Comma-separated OP role titles eligible to connect (plus global admin)
OP_ELIGIBLE_ROLE_TITLES=Project admin

# OAuth 2.0 (multi-OpenProject). Each OP admin registers an OAuth app on THEIR instance
# (Administration → Authentication → OAuth applications; Confidential; scope api_v3).
# Redirect URI on EVERY OP app must match OPENPROJECT_OAUTH_REDIRECT_URI exactly.
# Client id/secret are entered per connection in the UI and stored encrypted per workspace.
# Global CLIENT_ID/SECRET below are OPTIONAL local/single-tenant defaults only — they never
# override per-workspace credentials.
OPENPROJECT_OAUTH_CLIENT_ID=
OPENPROJECT_OAUTH_CLIENT_SECRET=
OPENPROJECT_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/workspaces/oauth/callback
OPENPROJECT_OAUTH_SCOPES=api_v3
OPENPROJECT_OAUTH_FRONTEND_SUCCESS_URL=http://localhost:4200/workspaces?oauth=success
OPENPROJECT_OAUTH_FRONTEND_ERROR_URL=http://localhost:4200/workspaces?oauth=error
OPENPROJECT_OAUTH_STATE_TTL_SECONDS=600

# --- Synchronization ---
SYNC_ENABLED=true
SYNC_INTERVAL_MS=3600000
SYNC_BATCH_SIZE=100
SYNC_RETRY_COUNT=1
SYNC_TIMEOUT=120
# Ops: max age (seconds) of last SUCCESS sync for stale-sync metric/alert (default 24h)
SYNC_SUCCESS_STALE_SECONDS=86400

# Reporting storage (immutable historical files; backed up with Postgres)
REPORT_STORAGE_PATH=./data/reports
REPORT_RETENTION_DAYS=90
REPORT_PURGE_ENABLED=true
MAX_REPORT_SIZE=10485760
ANALYTICS_SNAPSHOT_RETENTION_DAYS=90
ANALYTICS_SNAPSHOT_PURGE_ENABLED=true
OPENAPI_PUBLIC=true
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=14

# Observability compose (optional overlay)
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
